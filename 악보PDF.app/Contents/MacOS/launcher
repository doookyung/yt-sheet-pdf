#!/bin/bash
# 더블클릭 런처 (터미널 창 없이 실행). 프로젝트 루트 = .app 의 상위 폴더
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$ROOT"

if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3,10) else 1)'; then
  osascript -e 'display dialog "Python 3.10 이상이 필요합니다.\n\n확인을 누르면 다운로드 페이지가 열립니다. 설치 후 다시 더블클릭하세요." buttons {"확인"} default button 1 with icon caution'
  open "https://www.python.org/downloads/"
  exit 1
fi

if [ ! -x .venv/bin/python ]; then
  osascript -e 'display dialog "처음 실행입니다. 필요한 구성요소를 설치합니다 (1~2분).\n\n확인을 누르면 터미널 창이 열리고, 설치가 끝나면 앱이 자동으로 실행됩니다." buttons {"확인"} default button 1 with icon note'
  open -a Terminal "$ROOT/setup.sh"
  exit 0
fi

exec .venv/bin/python app.py
